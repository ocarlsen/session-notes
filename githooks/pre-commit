#!/usr/bin/env python3
"""session-notes pre-commit: generic safety checks on what is staged, for any git repo.

Installed by `bin/wt.py install-hooks` (as a shim that chains to any hook already there).
Checks only the staged blobs (read from the index, never the working tree):

  1. secrets: API-key shapes (the pattern from tests/leak_scan.py) and PEM private-key headers
  2. size: a staged file above [wt].size_cap_kb
  3. leak terms: only when this repo's root is listed in [wt].public_repos, the private terms
     file [wt].leak_terms (a missing file is a loud failure, never a skip)

Every finding prints with its file and reason; any finding exits 1. Bypassing with
--no-verify defeats the point.
"""
import importlib.util
import os
import re
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
CHECKOUT = os.path.dirname(HERE)
PEM = re.compile(r"-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----")


def _load(name, rel):
    spec = importlib.util.spec_from_file_location(name, os.path.join(CHECKOUT, rel))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def _git(*args):
    r = subprocess.run(["git"] + list(args), capture_output=True)
    return r.returncode, r.stdout


def _main_root():
    rc, out = _git("rev-parse", "--path-format=absolute", "--git-common-dir")
    if rc == 0 and out.strip():
        common = out.decode().strip()
        return os.path.realpath(os.path.dirname(common) if os.path.basename(common) == ".git" else common)
    rc, out = _git("rev-parse", "--show-toplevel")
    return os.path.realpath(out.decode().strip())


def main():
    leak = _load("leak_scan", "tests/leak_scan.py")
    nc = _load("notes_config", "bin/notes_config.py")
    try:
        cfg = nc.load()["wt"]
    except nc.ConfigError as exc:
        print("session-notes pre-commit: bad config: %s" % exc)
        return 1
    api_key = dict(leak.PUBLIC)["api key"]
    rc, out = _git("diff", "--cached", "--name-only", "--diff-filter=ACMRT", "-z")
    if rc != 0:
        print("session-notes pre-commit: git diff --cached failed (exit %d); the commit is "
              "refused because the staged files could not be listed" % rc)
        return 1
    files = [f for f in out.decode("utf-8", "replace").split("\0") if f]
    rc, top = _git("rev-parse", "--show-toplevel")
    toplevel = os.path.realpath(top.decode().strip())
    public = {os.path.realpath(p) for p in cfg["public_repos"]}
    is_public = bool(public & {toplevel, _main_root()})
    private = None
    if is_public:
        private = leak.load_terms(cfg["leak_terms"])
        if private is None:
            print("session-notes pre-commit: this repo is in wt.public_repos but the terms file "
                  "wt.leak_terms=%s does not exist; create it or remove the repo from the list"
                  % cfg["leak_terms"])
            return 1
    cap = cfg["size_cap_kb"] * 1024
    findings = []
    rc, lsout = _git("ls-files", "-s", "-z")
    modes = {}
    for ent in lsout.decode("utf-8", "replace").split("\0"):
        meta, _, path = ent.partition("\t")
        if path:
            modes[path] = meta.split(" ")[0]
    for f in files:
        if modes.get(f) == "160000":
            continue  # a submodule gitlink has no blob to read
        rc, blob = _git("show", ":" + f)
        if rc != 0:
            findings.append("%s: staged content could not be read (git show :path failed)" % f)
            continue
        if len(blob) > cap:
            findings.append("%s: size %d KB is over wt.size_cap_kb=%d" % (f, len(blob) // 1024 + 1, cfg["size_cap_kb"]))
        if b"\0" in blob[:8192]:
            continue
        text = blob.decode("utf-8", "replace")
        for n, line in enumerate(text.splitlines(), 1):
            if api_key.search(line):
                findings.append("%s:%d: secret: API key shape" % (f, n))
            if PEM.search(line):
                findings.append("%s:%d: secret: PEM private key header" % (f, n))
        if private:
            for n, kind, snip in leak.scan_text(text, private):
                if kind in ("private term", "private word"):
                    findings.append("%s:%d: leak: %s %r" % (f, n, kind, snip))
    for line in findings:
        print("pre-commit: " + line)
    if findings:
        print("pre-commit: %d finding(s); commit refused" % len(findings))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
